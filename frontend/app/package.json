{
  "name": "finanze",
  "version": "0.10.1",
  "description": "Self-hosted personal finance and net worth tracker that aggregates assets and investments across banks, brokers, crypto and real estate.",
  "main": "dist-electron/main/index.js",
  "packageManager": "pnpm@11.20.0",
  "keywords": [
    "portfolio-tracker",
    "personal-finance",
    "net-worth",
    "self-hosted",
    "open-banking",
    "psd2",
    "portfolio-manager",
    "investment-tracker",
    "expense-tracker",
    "financial-aggregation",
    "crypto-portfolio",
    "fintech",
    "privacy",
    "banking"
  ],
  "author": "marcosav",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:mobile": "pnpm run build:python && vite --host --mode mobile",
    "build": "tsc && vite build",
    "build:python": "node scripts/bundle-python.js",
    "build:mobile": "MOBILE_BUILD=1 pnpm run build && pnpm run build:python",
    "build:mobile:store": "export MOBILE_BUILD=1 INCLUDE_CONNECTIONS=0 && pnpm run build && pnpm run build:python",
    "install:pyodide": "node scripts/sync-python-wheels.mjs && node scripts/sync-pyodide.mjs",
    "clean": "node scripts/clean-offline.mjs",
    "preview": "vite preview",
    "dist": "vite build && pnpm exec electron-builder",
    "dist:win": "vite build && pnpm exec electron-builder --win",
    "dist:linux": "vite build && pnpm exec electron-builder --linux",
    "dist:mac:arm64": "vite build && pnpm exec electron-builder --mac --arm64",
    "dist:mac:x64": "vite build && pnpm exec electron-builder --mac --x64",
    "lint": "eslint .",
    "format": "prettier --write src electron test scripts '*.{json,js,cjs,ts,html}' pnpm-workspace.yaml public/site.webmanifest .prettierrc.json --ignore-unknown",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "lint-staged": "lint-staged --no-stash",
    "native:setup": "bash native/tlsclient/build.sh && bash native/tlsclient/install.sh",
    "native:setup:ios": "bash native/tlsclient/build.sh --platform ios && bash native/tlsclient/install.sh",
    "native:setup:android": "bash native/tlsclient/build.sh --platform android && bash native/tlsclient/install.sh",
    "cap:sync": "pnpm build:mobile && pnpm exec cap sync",
    "cap:sync:store": "pnpm build:mobile:store && pnpm exec cap sync",
    "cap:ios": "pnpm build:mobile && pnpm exec cap sync ios && pnpm exec cap open ios",
    "cap:ios:store": "pnpm build:mobile:store && pnpm exec cap sync ios && pnpm exec cap open ios",
    "cap:android": "pnpm build:mobile && pnpm exec cap sync android && pnpm exec cap open android",
    "cap:android:store": "pnpm build:mobile:store && pnpm exec cap sync android && pnpm exec cap open android"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,json,css}": [
      "eslint",
      "prettier --check"
    ],
    "**/*.{html,md,yaml,yml,webmanifest}": "prettier --check"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@capgo/capacitor-social-login": "^8.7.5",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-virtual": "^3.14.22",
    "capacitor-plugin-safe-area": "^5.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.11",
    "electron-window-state": "^5.0.3",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.61.0",
    "pyodide": "314.0.7",
    "react-day-picker": "^9.14.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electron": "^43.6.0",
    "electron-builder": "^26.18.0",
    "electron-is-dev": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jeep-sqlite": "^2.8.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^4.1.11"
  }
}
